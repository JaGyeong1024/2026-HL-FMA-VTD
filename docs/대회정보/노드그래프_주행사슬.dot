digraph G {
  rankdir=LR;
  splines=spline; overlap=false;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="HL FMA 주행 사슬 (실측 ROS 그래프)"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=7.5, color="#7b8a93", arrowsize=0.6];
  subgraph cluster_control {
    label="control"; fontsize=12; color="#b9c6cc"; style=rounded;
    "/control/autonomous_emergency_braking" [label="autonomous_emergency_braking", fillcolor="#fdf0e3"];
    "/control/autoware_operation_mode_transition_manager" [label="autoware_operation_mode_transition_manager", fillcolor="#fdf0e3"];
    "/control/autoware_shift_decider" [label="autoware_shift_decider", fillcolor="#fdf0e3"];
    "/control/control_validator" [label="control_validator", fillcolor="#fdf0e3"];
    "/control/trajectory_follower/controller_node_exe" [label="controller_node_exe", fillcolor="#fdf0e3"];
    "/control/trajectory_follower/lane_departure_checker_node" [label="lane_departure_checker_node", fillcolor="#fdf0e3"];
    "/control/vehicle_cmd_gate" [label="vehicle_cmd_gate", fillcolor="#fdf0e3"];
  }
  subgraph cluster_lane_planner {
    label="lane_planner"; fontsize=12; color="#b9c6cc"; style=rounded;
    "/lane_planner" [label="lane_planner", fillcolor="#f2f4f5"];
  }
  subgraph cluster_planning {
    label="planning"; fontsize=12; color="#b9c6cc"; style=rounded;
    "/planning/mission_planning/mission_planner" [label="mission_planner", fillcolor="#e8f0fb"];
    "/planning/mission_planning/route_selector" [label="route_selector", fillcolor="#e8f0fb"];
    "/planning/planning_validator" [label="planning_validator", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/external_velocity_limit_selector" [label="external_velocity_limit_selector", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner" [label="behavior_path_planner", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/lane_driving/behavior_planning/behavior_velocity_planner" [label="behavior_velocity_planner", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/lane_driving/motion_planning/elastic_band_smoother" [label="elastic_band_smoother", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/lane_driving/motion_planning/motion_velocity_planner" [label="motion_velocity_planner", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/lane_driving/motion_planning/path_optimizer" [label="path_optimizer", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/scenario_selector" [label="scenario_selector", fillcolor="#e8f0fb"];
    "/planning/scenario_planning/velocity_smoother" [label="velocity_smoother", fillcolor="#e8f0fb"];
  }
  subgraph cluster_vtd_autoware_bridge {
    label="vtd_autoware_bridge"; fontsize=12; color="#b9c6cc"; style=rounded;
    "/vtd_autoware_bridge" [label="vtd_autoware_bridge", fillcolor="#f2f4f5"];
  }
  subgraph cluster_vtd_route_node {
    label="vtd_route_node"; fontsize=12; color="#b9c6cc"; style=rounded;
    "/vtd_route_node" [label="vtd_route_node", fillcolor="#f2f4f5"];
  }
