+TEST_F(TestNormalLaneChange, externalRequestNeighborsIncludeNonPreferredCurrentLane)
+{
+  normal_lane_change_->update_lanes(false);
+  const auto & current_lanes = normal_lane_change_->get_current_lanes();
+  const auto & route_handler = *planner_data_->route_handler;
+  ASSERT_FALSE(current_lanes.empty());
+  bool has_non_preferred = false;
+  for (const auto & lane : current_lanes) {
+    has_non_preferred |= route_handler.getNumLaneToPreferredLane(lane) != 0;
+  }
+  ASSERT_TRUE(has_non_preferred);
+  const auto neighbors =
+    autoware::behavior_path_planner::utils::lane_change::get_target_neighbor_lanes(
+      route_handler, current_lanes, LaneChangeModuleType::EXTERNAL_REQUEST);
+  ASSERT_EQ(neighbors.size(), current_lanes.size());
+  for (size_t i = 0; i < current_lanes.size(); ++i) {
+    EXPECT_EQ(neighbors[i].id(), current_lanes[i].id());
+  }
+}
